<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 测试项目放在仓库根目录下，排除出默认通配，否则其源码会被主项目一起编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CountTimer.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="1.9.12" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.193" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Holidays\*.json" />
    <!-- 法定节假日安排的内置兜底数据，来源与许可见同目录下的 LICENSE.holiday-cn.txt -->
    <EmbeddedResource Include="Resources\Holidays\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CountTimer.Tests" />
  </ItemGroup>

</Project>